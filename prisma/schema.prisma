// Shama Business Incubator — data model
// Covers the core entities in PRD §51. The application/selection slice is
// fully wired to the UI; participant, mentorship, pitch and funding tables are
// modelled now so later phases do not require a migration of existing data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  APPLICANT
  PARTICIPANT
  MENTOR
  FACILITATOR
  JUDGE
  ADMIN
  SUPER_ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  NOT_SELECTED
  WITHDRAWN
}

enum ClusterKey {
  CREATIVE_CRAFT
  AGRIC_AGRIBUSINESS
  FISHERIES_AQUACULTURE
  TECH_INNOVATION
}

enum RegistrationStatus {
  NOT_REGISTERED
  IN_PROGRESS
  REGISTERED
}

enum BusinessStage {
  IDEA
  EARLY_STAGE
  OPERATING
  GROWING
}

enum DocumentKind {
  IDENTIFICATION
  BUSINESS_REGISTRATION
  PITCH_DECK
  BUSINESS_PLAN
  PRODUCT_IMAGES
  FINANCIAL_INFO
  OTHER
}

enum NotificationChannel {
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum PipelineStage {
  PROSPECT
  CONTACTED
  MEETING
  PROPOSAL_SENT
  NEGOTIATION
  COMMITTED
  RECEIVED
  CLOSED
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------- identity

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?
  passwordHash  String
  fullName      String
  role          Role      @default(APPLICANT)
  phoneVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  applications  Application[]
  reviews       Review[]
  notifications Notification[]
  auditLogs     AuditLog[]
  participant   Participant?
  refreshTokens RefreshToken[]

  @@index([role])
}

/// One row per issued refresh token.
///
/// Refresh tokens are JWTs, but the server keeps a record of each one so that
/// it can be rotated and revoked — a stateless refresh token cannot be taken
/// away from a stolen device. Only the SHA-256 hash of the token is stored, so
/// a database leak does not hand out working credentials.
///
/// `familyId` chains every rotation descended from one login. If a token that
/// has already been rotated away is presented again, that is either replay or
/// theft, so the entire family is revoked and the user must sign in again.
model RefreshToken {
  id           String    @id @default(cuid())
  jti          String    @unique
  familyId     String
  tokenHash    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- programme

model Cohort {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  year             Int
  seats            Int       @default(120)
  applicationsOpen Boolean   @default(true)
  opensAt          DateTime?
  closesAt         DateTime?
  bootcampStartsAt DateTime?
  ultimatePitchAt  DateTime?
  isActive         Boolean   @default(false)
  createdAt        DateTime  @default(now())

  applications Application[]
  participants Participant[]
  questions    ApplicationQuestion[]
  criteria     ScoringCriterion[]
}

// --------------------------------------------------------------- applications

model Application {
  id          String            @id @default(cuid())
  reference   String            @unique
  status      ApplicationStatus @default(DRAFT)
  cluster     ClusterKey?
  currentStep Int               @default(1)
  submittedAt DateTime?
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id])

  // applicant (PRD §9.1)
  dateOfBirth   DateTime?
  gender        String?
  community     String?
  eligibility   Boolean   @default(false)
  consentData   Boolean   @default(false)
  consentPublic Boolean   @default(false)

  // business (PRD §9.2)
  businessName        String?
  businessLocation    String?
  registrationStatus  RegistrationStatus?
  businessStage       BusinessStage?
  businessDescription String?
  problemSolved       String?
  productService      String?
  targetMarket        String?
  currentCustomers    String?
  monthlyRevenue      String?
  employees           Int?
  yearsOperating      Float?
  challenges          String?
  growthPlans         String?
  fundingRequired     Int?
  fundingUse          String?

  // founder (PRD §9.3)
  founderBackground String?
  experience        String?
  education         String?
  priorVenture      String?
  motivation        String?
  goals             String?
  referralSource    String?

  answers     ApplicationAnswer[]
  documents   Document[]
  reviews     Review[]
  notes       Note[]
  participant Participant?

  @@index([status])
  @@index([cluster])
  @@index([cohortId, status])
}

model ApplicationQuestion {
  id       String   @id @default(cuid())
  cohortId String
  cohort   Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  section  String
  label    String
  helpText String?
  type     String // short_text | long_text | select | radio | checkbox | yes_no | number | file
  options  String[] @default([])
  required Boolean  @default(false)
  order    Int      @default(0)
  active   Boolean  @default(true)

  answers ApplicationAnswer[]
}

model ApplicationAnswer {
  id            String              @id @default(cuid())
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      ApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value         String?

  @@unique([applicationId, questionId])
}

model Document {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          DocumentKind
  fileName      String
  url           String
  contentType   String?
  size          Int?
  uploadedAt    DateTime     @default(now())
}

// ------------------------------------------------------------------ scoring

model ScoringCriterion {
  id          String  @id @default(cuid())
  cohortId    String
  cohort      Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  name        String
  description String?
  weight      Int     @default(1)
  maxScore    Int     @default(10)
  order       Int     @default(0)

  scores Score[]
}

model Review {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  comment       String?
  total         Float       @default(0)
  submittedAt   DateTime?
  createdAt     DateTime    @default(now())

  scores Score[]

  @@unique([applicationId, reviewerId])
}

model Score {
  id          String           @id @default(cuid())
  reviewId    String
  review      Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   ScoringCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  value       Int

  @@unique([reviewId, criterionId])
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorName    String
  body          String
  createdAt     DateTime    @default(now())
}

// -------------------------------------------------------------- participants

model Participant {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId  String      @unique
  application    Application @relation(fields: [applicationId], references: [id])
  cohortId       String
  cohort         Cohort      @relation(fields: [cohortId], references: [id])
  cluster        ClusterKey
  stage          String      @default("Onboarding")
  publicProfile  Boolean     @default(false)
  photoUrl       String?
  attendanceRate Int         @default(0)
  createdAt      DateTime    @default(now())

  mentorId String?
  mentor   Mentor? @relation(fields: [mentorId], references: [id])
}

model Mentor {
  id           String       @id @default(cuid())
  fullName     String
  organisation String?
  position     String?
  industry     String?
  expertise    String[]     @default([])
  clusters     ClusterKey[] @default([])
  yearsExp     Int?
  bio          String?
  email        String       @unique
  phone        String?
  photoUrl     String?
  published    Boolean      @default(false)
  createdAt    DateTime     @default(now())

  mentees Participant[]
}

// ------------------------------------------------------------ communications

model Notification {
  id         String              @id @default(cuid())
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel    NotificationChannel
  status     NotificationStatus  @default(QUEUED)
  to         String
  subject    String?
  body       String
  template   String?
  providerId String?
  error      String?
  createdAt  DateTime            @default(now())
  sentAt     DateTime?

  @@index([channel, status])
  @@index([createdAt])
}

model MessageTemplate {
  id        String              @id @default(cuid())
  key       String              @unique
  name      String
  channel   NotificationChannel @default(SMS)
  body      String
  updatedAt DateTime            @updatedAt
}

// ------------------------------------------------------------------- public

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  category  String
  message   String
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model PartnerLead {
  id             String        @id @default(cuid())
  organisation   String
  contactPerson  String
  email          String
  phone          String?
  orgType        String?
  interest       String?
  level          String?
  message        String?
  category       String        @default("Corporate & Institutional Partners")
  stage          PipelineStage @default(PROSPECT)
  potentialValue Int?
  lastContactAt  DateTime?
  nextAction     String?
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([stage])
}

model Partner {
  id       String  @id @default(cuid())
  name     String
  logoUrl  String?
  website  String?
  tier     String?
  featured Boolean @default(false)
  order    Int     @default(0)
}

model MentorInterest {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  organisation String?
  expertise    String?
  clusters     String[] @default([])
  motivation   String?
  createdAt    DateTime @default(now())
}

model Post {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  body        String
  category    String        @default("News")
  coverUrl    String?
  author      String        @default("Programme Team")
  status      ContentStatus @default(PUBLISHED)
  publishedAt DateTime      @default(now())
  seoTitle    String?
  seoDesc     String?

  @@index([status, publishedAt])
}

model Event {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime?
  location    String
  kind        String        @default("Information Session")
  stage       String?
  registerUrl String?
  coverUrl    String?
  status      ContentStatus @default(PUBLISHED)

  @@index([startsAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
